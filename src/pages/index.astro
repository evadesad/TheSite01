---
import BaseLayout from '../layouts/BaseLayout.astro';
import { band, events, photos, reels } from '../data/band.js';

const today = new Date();
const upcomingEvents = events
  .filter((event) => {
    const date = new Date(event.date + 'T00:00:00');
    return !Number.isNaN(date.getTime()) && date >= new Date(today.getFullYear(), today.getMonth(), today.getDate());
  })
  .sort((a, b) => a.date.localeCompare(b.date));
const hasUpcomingEvents = upcomingEvents.length > 0;
const assetPath = (src) => import.meta.env.BASE_URL + src.replace(/^\/+/, '');
const logoPath = assetPath('mellonials-logo.png');
const dateLabel = (value, locale = 'uk-UA') => new Intl.DateTimeFormat(locale, {
  day: 'numeric', month: 'short', year: 'numeric',
}).format(new Date(value + 'T00:00:00'));
const photoAltUk = {
  'The band': 'Гурт The Mellonials',
  'The vocalist': 'Вокаліст гурту',
  'The guitarist': 'Гітарист гурту',
};
const reelTitleUk = {
  'Live in Alive': 'Виступ наживо в Alive',
  'Live play': 'Живе виконання',
  'Band is performing': 'Виступ гурту',
};
---
<BaseLayout>
  <Fragment slot="head">
    <title>The Mellonials — Рок-гурт із Вроцлава</title>
    <meta name="description" content="The Mellonials — живий рок-гурт із Вроцлава: кавери та власна музика." />
  </Fragment>

  <header class="site-header">
    <a class="brand-logo" href="#home" aria-label="The Mellonials home"><img src={logoPath} alt="" /></a>
    <nav aria-label="Основна навігація" data-i18n-aria="navLabel">
      {hasUpcomingEvents && <a class="nav-shows" href="#shows" data-i18n="navShows">Концерти</a>}
      <a class="nav-about" href="#about" data-i18n="navAbout">Про гурт</a>
      <a href="#media" data-i18n="navMedia">Медіа</a>
      <div class="language-switch" role="group" aria-label="Мова" data-i18n-aria="languageLabel">
        <button type="button" data-language-choice="uk" aria-pressed="true">УКР</button>
        <button type="button" data-language-choice="en" aria-pressed="false">EN</button>
      </div>
      <a class="nav-book" href={band.bookingUrl} target="_blank" rel="noreferrer"><span data-i18n="navBook">Замовити виступ</span><span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="live-dot"></span><span data-i18n="heroEyebrow">ЖИВИЙ РОК · ВРОЦЛАВ, ПОЛЬЩА</span></p>
        <h1 id="hero-title" data-i18n="heroTitle" data-i18n-html="true">КАВЕРИ ТА РОК.<br /><span>ВЛАСНА МУЗИКА.</span></h1>
        <p class="hero-intro" data-i18n="heroIntro">Живий рок-гурт із Вроцлава. Кавери та власна музика.</p>
        <a class="button button-light" href={band.bookingUrl} target="_blank" rel="noreferrer"><span data-i18n="heroBook">Замовити виступ в Instagram</span><span aria-hidden="true">↗</span></a>
        {hasUpcomingEvents && <a class="text-link" href="#shows"><span data-i18n="heroShows">Найближчі концерти</span> <span aria-hidden="true">↓</span></a>}
      </div>
      <div class="hero-logo" aria-hidden="true"><img src={logoPath} alt="" /></div>
      <div class="hero-foot"><span data-i18n="heroFoot">КАВЕРИ · ВЛАСНА МУЗИКА · ВРОЦЛАВ</span><span>51°06' N&nbsp; 17°02' E</span></div>
    </section>

    {hasUpcomingEvents && (
      <section class="shows section-wrap" id="shows" aria-labelledby="shows-title">
        <div class="section-heading"><p class="eyebrow" data-i18n="showsEyebrow">ПОБАЧИМОСЯ НАЖИВО</p><h2 id="shows-title" data-i18n="showsTitle" data-i18n-html="true">НАСТУПНІ ВИСТУПИ<span>.</span></h2></div>
        <ul class="event-list">
          {upcomingEvents.map((event) => (
            <li class="event-row">
              <time datetime={event.date} data-event-date={event.date}>{dateLabel(event.date, 'uk-UA')}</time>
              <div><strong>{event.venue}</strong><span data-event-city={event.city}>{event.city === 'Wrocław' ? 'Вроцлав' : event.city}</span></div>
              {event.time && <span class="event-time" data-event-time={event.time}>{event.time === 'Time TBA' ? 'Час уточнюється' : event.time}</span>}
              {event.url ? <a class="event-link" href={event.url}><span data-i18n="eventDetails">Деталі</span> <span aria-hidden="true">↗</span></a> : <span class="event-link muted" data-i18n="eventSoon">Деталі незабаром</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="about section-wrap" id="about" aria-labelledby="about-title">
      <div class="section-heading"><p class="eyebrow" data-i18n="aboutEyebrow">ГУРТ ІЗ ВРОЦЛАВА</p><h2 id="about-title" data-i18n="aboutTitle" data-i18n-html="true">КАВЕРИ ТА<br /><span>ВЛАСНІ ПІСНІ.</span></h2></div>
      <div class="about-copy"><p data-i18n="aboutDescription">Живий рок-гурт із Вроцлава: кавери та власна музика.</p><p data-i18n="aboutMore">Виконуємо знайомі пісні й ділимося власною музикою.</p><a class="text-link" href={band.instagramUrl} target="_blank" rel="noreferrer"><span data-i18n="followInstagram">Стежити в Instagram</span> <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="media section-wrap" id="media" aria-labelledby="media-title">
      <div class="section-heading media-heading"><div><p class="eyebrow" data-i18n="mediaEyebrow">ФОТО ТА ВІДЕО</p><h2 id="media-title" data-i18n="mediaTitle" data-i18n-html="true">ГУРТ НАЖИВО<span>.</span></h2></div><span class="media-note" data-i18n="mediaNote">ФОТОГАЛЕРЕЯ · INSTAGRAM REELS</span></div>
      <div class="gallery" aria-label="Фотогалерея гурту" data-i18n-aria="galleryLabel">
        {photos.length ? photos.map((photo) => (
          <figure class="photo"><img src={assetPath(photo.src)} alt={photoAltUk[photo.alt] || photo.alt} data-alt-uk={photoAltUk[photo.alt] || photo.alt} data-alt-en={photo.alt} loading="lazy" /></figure>
        )) : (
          <div class="media-placeholder"><span aria-hidden="true">✳</span><p data-i18n="photoPlaceholder">ФОТО ДОДАЮТЬСЯ</p><small><span data-i18n="photoInstruction">Додайте фото до папки</span> <code>public/photos</code>.</small></div>
        )}
      </div>
      <div class="reels-row">
        <div><p class="eyebrow" data-i18n="soundEyebrow">ЖИВИЙ ЗВУК</p><h3 data-i18n="reelsTitle" data-i18n-html="true">ПОЧУЙТЕ<br /><span>НАС НАЖИВО.</span></h3></div>
        <div class="reels-list">
          {reels.length ? reels.map((reel) => {
            const titleUk = reelTitleUk[reel.title] || reel.title;
            return <a href={reel.url} target="_blank" rel="noreferrer"><span data-reel-title-en={reel.title} data-reel-title-uk={titleUk}>{titleUk}</span><span aria-hidden="true">↗</span></a>;
          }) : <p data-i18n="reelsPlaceholder">Відео гурту додаються.</p>}
          <a class="instagram-link" href={band.instagramUrl + 'reels/'} target="_blank" rel="noreferrer"><span data-i18n="watchReels">Дивитися Reels в Instagram</span> <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="booking" aria-labelledby="booking-title">
      <p class="eyebrow" data-i18n="bookingEyebrow">ПЛАНУЄТЕ ПОДІЮ?</p><h2 id="booking-title" data-i18n="bookingTitle" data-i18n-html="true">ЗАПРОСІТЬ<br />ГУРТ <span>НА СЦЕНУ.</span></h2>
      <a class="button button-dark" href={band.bookingUrl} target="_blank" rel="noreferrer"><span data-i18n="bookingCta">Написати лідеру гурту</span> <span aria-hidden="true">↗</span></a>
    </section>
  </main>

  <footer class="site-footer"><a class="brand-logo" href="#home" aria-label="The Mellonials home"><img src={logoPath} alt="" /></a><span data-i18n="footerTagline">ЖИВИЙ РОК ІЗ ВРОЦЛАВА</span><a href={band.instagramUrl} target="_blank" rel="noreferrer">INSTAGRAM ↗</a><span>© {new Date().getFullYear()}</span></footer>

  <script is:inline>
    (() => {
      const copy = {
        uk: {
          documentTitle: 'The Mellonials — Рок-гурт із Вроцлава',
          metaDescription: 'The Mellonials — живий рок-гурт із Вроцлава: кавери та власна музика.',
          navLabel: 'Основна навігація',
          languageLabel: 'Вибір мови',
          navShows: 'Концерти',
          navAbout: 'Про гурт',
          navMedia: 'Медіа',
          navBook: 'Замовити виступ',
          heroEyebrow: 'ЖИВИЙ РОК · ВРОЦЛАВ, ПОЛЬЩА',
          heroTitle: 'КАВЕРИ ТА РОК.<br /><span>ВЛАСНА МУЗИКА.</span>',
          heroIntro: 'Живий рок-гурт із Вроцлава. Кавери та власна музика.',
          heroBook: 'Замовити виступ в Instagram',
          heroShows: 'Найближчі концерти',
          heroFoot: 'КАВЕРИ · ВЛАСНА МУЗИКА · ВРОЦЛАВ',
          showsEyebrow: 'ПОБАЧИМОСЯ НАЖИВО',
          showsTitle: 'НАСТУПНІ ВИСТУПИ<span>.</span>',
          eventDetails: 'Деталі',
          eventSoon: 'Деталі незабаром',
          aboutEyebrow: 'ГУРТ ІЗ ВРОЦЛАВА',
          aboutTitle: 'КАВЕРИ ТА<br /><span>ВЛАСНІ ПІСНІ.</span>',
          aboutDescription: 'Живий рок-гурт із Вроцлава: кавери та власна музика.',
          aboutMore: 'Виконуємо знайомі пісні й ділимося власною музикою.',
          followInstagram: 'Стежити в Instagram',
          galleryLabel: 'Фотогалерея гурту The Mellonials',
          mediaEyebrow: 'ФОТО ТА ВІДЕО',
          mediaTitle: 'ГУРТ НАЖИВО<span>.</span>',
          mediaNote: 'ФОТОГАЛЕРЕЯ · INSTAGRAM REELS',
          photoPlaceholder: 'ФОТО ДОДАЮТЬСЯ',
          photoInstruction: 'Додайте фото до папки',
          soundEyebrow: 'ЖИВИЙ ЗВУК',
          reelsTitle: 'ПОЧУЙТЕ<br /><span>НАС НАЖИВО.</span>',
          reelsPlaceholder: 'Відео гурту додаються.',
          watchReels: 'Дивитися Reels в Instagram',
          bookingEyebrow: 'ПЛАНУЄТЕ ПОДІЮ?',
          bookingTitle: 'ЗАПРОСІТЬ<br />ГУРТ <span>НА СЦЕНУ.</span>',
          bookingCta: 'Написати лідеру гурту',
          footerTagline: 'ЖИВИЙ РОК ІЗ ВРОЦЛАВА',
        },
        en: {
          documentTitle: 'The Mellonials — Live rock from Wrocław',
          metaDescription: 'The Mellonials — a live rock band from Wrocław, playing covers and original music.',
          navLabel: 'Main navigation',
          languageLabel: 'Choose language',
          navShows: 'Shows',
          navAbout: 'About',
          navMedia: 'Media',
          navBook: 'Book the band',
          heroEyebrow: 'LIVE ROCK · WROCŁAW, POLAND',
          heroTitle: 'COVERS AND ROCK.<br /><span>ORIGINAL MUSIC.</span>',
          heroIntro: 'A live rock band from Wrocław, playing covers and original music.',
          heroBook: 'Book us on Instagram',
          heroShows: 'Upcoming shows',
          heroFoot: 'COVERS · ORIGINAL MUSIC · WROCŁAW',
          showsEyebrow: 'CATCH US LIVE',
          showsTitle: 'UP NEXT<span>.</span>',
          eventDetails: 'Details',
          eventSoon: 'Details soon',
          aboutEyebrow: 'A BAND FROM WROCŁAW',
          aboutTitle: 'COVERS AND<br /><span>ORIGINAL SONGS.</span>',
          aboutDescription: 'A live rock band from Wrocław, playing covers and original music.',
          aboutMore: 'Familiar songs alongside the band’s own music.',
          followInstagram: 'Follow on Instagram',
          galleryLabel: 'Photo gallery for The Mellonials',
          mediaEyebrow: 'PHOTOS & VIDEOS',
          mediaTitle: 'THE BAND LIVE<span>.</span>',
          mediaNote: 'PHOTO GALLERY · INSTAGRAM REELS',
          photoPlaceholder: 'PHOTOS COMING SOON',
          photoInstruction: 'Add photos to',
          soundEyebrow: 'LIVE SOUND',
          reelsTitle: 'HEAR US<br /><span>LIVE.</span>',
          reelsPlaceholder: 'Band videos coming soon.',
          watchReels: 'Watch Reels on Instagram',
          bookingEyebrow: 'PLANNING AN EVENT?',
          bookingTitle: 'BRING THE<br /><span>BAND ON STAGE.</span>',
          bookingCta: 'Message the band leader',
          footerTagline: 'LIVE ROCK FROM WROCŁAW',
        },
      };

      const applyLanguage = (language) => {
        const selected = language === 'en' ? 'en' : 'uk';
        const strings = copy[selected];
        document.documentElement.lang = selected;
        document.title = strings.documentTitle;
        const description = document.querySelector('meta[name="description"]');
        if (description) description.content = strings.metaDescription;
        document.querySelectorAll('[data-i18n]').forEach((element) => {
          const value = strings[element.dataset.i18n];
          if (typeof value !== 'string') return;
          if (element.dataset.i18nHtml === 'true') element.innerHTML = value;
          else element.textContent = value;
        });
        document.querySelectorAll('[data-i18n-aria]').forEach((element) => {
          const value = strings[element.dataset.i18nAria];
          if (typeof value === 'string') element.setAttribute('aria-label', value);
        });
        document.querySelectorAll('[data-event-date]').forEach((element) => {
          const date = new Date(element.dataset.eventDate + 'T00:00:00');
          element.textContent = new Intl.DateTimeFormat(selected === 'uk' ? 'uk-UA' : 'en', {
            day: 'numeric', month: 'short', year: 'numeric',
          }).format(date);
        });
        document.querySelectorAll('[data-event-city]').forEach((element) => {
          const city = element.dataset.eventCity;
          element.textContent = selected === 'uk' && city === 'Wrocław' ? 'Вроцлав' : city;
        });
        document.querySelectorAll('[data-event-time]').forEach((element) => {
          const time = element.dataset.eventTime;
          element.textContent = selected === 'uk' && time === 'Time TBA' ? 'Час уточнюється' : time;
        });
        document.querySelectorAll('[data-alt-en]').forEach((element) => {
          element.alt = selected === 'uk' ? element.dataset.altUk : element.dataset.altEn;
        });
        document.querySelectorAll('[data-reel-title-en]').forEach((element) => {
          element.textContent = selected === 'uk' ? element.dataset.reelTitleUk : element.dataset.reelTitleEn;
        });
        document.querySelectorAll('[data-language-choice]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.languageChoice === selected));
        });
        try { localStorage.setItem('the-mellonials-language', selected); } catch {}
      };
      document.addEventListener('click', (event) => {
        const button = event.target.closest('[data-language-choice]');
        if (button) applyLanguage(button.dataset.languageChoice);
      });
      let savedLanguage = 'uk';
      try { savedLanguage = localStorage.getItem('the-mellonials-language') || 'uk'; } catch {}
      applyLanguage(savedLanguage);
    })();
  </script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');
  :global(*){box-sizing:border-box} :global(html){scroll-behavior:smooth;scroll-padding-top:90px} :global(body){margin:0;background:#10100f;color:#f4f0e8;font-family:'Space Grotesk',Arial,sans-serif} :global(a){color:inherit;text-decoration:none} :global(a:focus-visible){outline:2px solid #ed5632;outline-offset:5px}
  .site-header{height:88px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff20}.brand-logo{display:flex;align-items:center;flex-shrink:0}.brand-logo img{display:block;width:54px;height:54px;object-fit:contain;border-radius:50%}.site-footer .brand-logo img{width:66px;height:66px}.section-heading h2 span,.hero h1 span,.booking h2 span{color:#ed5632}.site-header nav{display:flex;align-items:center;gap:34px;font-size:13px}.site-header nav>a:not(.nav-book){color:#b7b3ad}.language-switch{display:flex;gap:2px;padding:3px;border:1px solid #ffffff35}.language-switch button{border:0;background:transparent;color:#b7b3ad;padding:6px 7px;font:10px 'DM Mono',monospace;cursor:pointer}.language-switch button[aria-pressed='true']{background:#ed5632;color:#10100f}.language-switch button:focus-visible{outline:2px solid #f4f0e8;outline-offset:2px}.nav-book{border:1px solid #ffffff55;padding:12px 16px}.nav-book span,.button span{margin-left:15px;color:#ed5632}.hero{min-height:610px;padding:100px 10vw 34px;position:relative;overflow:hidden;background:radial-gradient(ellipse at 79% 50%,#503022 0,#211813 24%,#10100f 55%)}.hero-copy{position:relative;z-index:1}.eyebrow,.hero-foot,.media-note,.site-footer>span,.site-footer>a:last-of-type{font:10px 'DM Mono',monospace;letter-spacing:.12em;color:#a7a198}.eyebrow{display:flex;align-items:center;gap:9px}.live-dot{width:7px;height:7px;border-radius:50%;background:#ed5632;box-shadow:0 0 12px #ed5632}.hero h1{font-size:clamp(58px,9vw,124px);line-height:.86;letter-spacing:-.085em;margin:36px 0 24px}.hero-intro{max-width:360px;color:#b7b3ad;line-height:1.6;margin-bottom:30px}.button{display:inline-flex;align-items:center;padding:16px 20px;font-size:13px;font-weight:600}.button-light{background:#f4f0e8;color:#10100f}.text-link{display:block;width:max-content;margin-top:21px;font-size:12px;border-bottom:1px solid #777;padding-bottom:5px}.text-link span{color:#ed5632}.hero-logo{position:absolute;