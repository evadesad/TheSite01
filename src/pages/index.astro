---
import BaseLayout from '../layouts/BaseLayout.astro';
import { band, events, photos, reels } from '../data/band.js';

const today = new Date();
const upcomingEvents = events
  .filter((event) => {
    const date = new Date(`${event.date}T00:00:00`);
    return !Number.isNaN(date.getTime()) && date >= new Date(today.getFullYear(), today.getMonth(), today.getDate());
  })
  .sort((a, b) => a.date.localeCompare(b.date));
const hasUpcomingEvents = upcomingEvents.length > 0;
const dateLabel = (value) => new Intl.DateTimeFormat('en', {
  day: 'numeric', month: 'short', year: 'numeric',
}).format(new Date(`${value}T00:00:00`));
---
<BaseLayout>
  <Fragment slot="head">
    <title>{band.name} — Live rock from Wrocław</title>
    <meta name="description" content={`${band.name} is a live rock band from Wrocław, Poland, playing covers and original music.`} />
  </Fragment>

  <header class="site-header">
    <a class="wordmark" href="#home" aria-label={`${band.name} home`}>THE<br />MELLONIALS<span>.</span></a>
    <nav aria-label="Main navigation">
      {hasUpcomingEvents && <a href="#shows">Shows</a>}
      <a href="#about">About</a>
      <a href="#media">Media</a>
      <a class="nav-book" href={band.bookingUrl} target="_blank" rel="noreferrer">Book the band <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="live-dot"></span> LIVE ROCK · WROCŁAW, POLAND</p>
        <h1 id="hero-title">LOUD HEARTS.<br /><span>GOOD SONGS.</span></h1>
        <p class="hero-intro">A live rock band playing the songs you love and the ones we wrote ourselves.</p>
        <a class="button button-light" href={band.bookingUrl} target="_blank" rel="noreferrer">Book us on Instagram <span aria-hidden="true">↗</span></a>
        {hasUpcomingEvents && <a class="text-link" href="#shows">See upcoming shows <span aria-hidden="true">↓</span></a>}
      </div>
      <div class="hero-mark" aria-hidden="true"><span>M</span><i>✳</i></div>
      <div class="hero-foot"><span>INDEPENDENT · LOUD · LIVE</span><span>51°06' N&nbsp; 17°02' E</span></div>
    </section>

    {hasUpcomingEvents && (
      <section class="shows section-wrap" id="shows" aria-labelledby="shows-title">
        <div class="section-heading"><p class="eyebrow">CATCH US LIVE</p><h2 id="shows-title">UP NEXT<span>.</span></h2></div>
        <ul class="event-list">
          {upcomingEvents.map((event) => (
            <li class="event-row">
              <time datetime={event.date}>{dateLabel(event.date)}</time>
              <div><strong>{event.venue}</strong><span>{event.city}</span></div>
              {event.time && <span class="event-time">{event.time}</span>}
              {event.url ? <a class="event-link" href={event.url}>Details <span aria-hidden="true">↗</span></a> : <span class="event-link muted">Details soon</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="about section-wrap" id="about" aria-labelledby="about-title">
      <div class="section-heading"><p class="eyebrow">A BAND FROM {band.location.toUpperCase()}</p><h2 id="about-title">OLD FAVOURITES.<br /><span>NEW NOISE.</span></h2></div>
      <div class="about-copy"><p>{band.description}</p><p>From familiar riffs to original songs, every set is made to be heard together, loud.</p><a class="text-link" href={band.instagramUrl} target="_blank" rel="noreferrer">Follow along on Instagram <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="media section-wrap" id="media" aria-labelledby="media-title">
      <div class="section-heading media-heading"><div><p class="eyebrow">A LOOK &amp; A LISTEN</p><h2 id="media-title">THE FEELING<span>.</span></h2></div><span class="media-note">PHOTOS &amp; LIVE CLIPS</span></div>
      <div class="gallery" aria-label="Band photo gallery">
        {photos.length ? photos.map((photo) => (
          <figure class="photo"><img src={photo.src} alt={photo.alt} loading="lazy" /></figure>
        )) : (
          <div class="media-placeholder"><span aria-hidden="true">✳</span><p>PHOTO PLACEHOLDER</p><small>Add a band photoshoot image in <code>src/data/band.js</code>.</small></div>
        )}
      </div>
      <div class="reels-row">
        <div><p class="eyebrow">SOUND ON</p><h3>HEAR IT<br />FOR YOURSELF.</h3></div>
        <div class="reels-list">
          {reels.length ? reels.map((reel) => <a href={reel.url} target="_blank" rel="noreferrer">{reel.title}<span aria-hidden="true">↗</span></a>) : <p>Reels placeholder — add individual video links in <code>src/data/band.js</code>.</p>}
          <a class="instagram-link" href={`${band.instagramUrl}reels/`} target="_blank" rel="noreferrer">Watch Reels on Instagram <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="booking" aria-labelledby="booking-title">
      <p class="eyebrow">HAVE A STAGE IN MIND?</p><h2 id="booking-title">LET’S MAKE<br />SOME <span>NOISE.</span></h2>
      <a class="button button-dark" href={band.bookingUrl} target="_blank" rel="noreferrer">Message the band leader <span aria-hidden="true">↗</span></a>
    </section>
  </main>

  <footer class="site-footer"><a class="wordmark" href="#home">THE<br />MELLONIALS<span>.</span></a><span>LIVE ROCK FROM WROCŁAW</span><a href={band.instagramUrl} target="_blank" rel="noreferrer">INSTAGRAM ↗</a><span>© {new Date().getFullYear()}</span></footer>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');
  :global(*){box-sizing:border-box} :global(html){scroll-behavior:smooth;scroll-padding-top:90px} :global(body){margin:0;background:#10100f;color:#f4f0e8;font-family:'Space Grotesk',Arial,sans-serif} :global(a){color:inherit;text-decoration:none} :global(a:focus-visible){outline:2px solid #ed5632;outline-offset:5px}
  .site-header{height:88px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff20}.wordmark{font-weight:700;font-size:15px;line-height:.85;letter-spacing:-.08em}.wordmark span,.section-heading h2 span,.hero h1 span,.booking h2 span{color:#ed5632}.site-header nav{display:flex;align-items:center;gap:34px;font-size:13px}.site-header nav>a:not(.nav-book){color:#b7b3ad}.nav-book{border:1px solid #ffffff55;padding:12px 16px}.nav-book span,.button span{margin-left:15px;color:#ed5632}.hero{min-height:610px;padding:100px 10vw 34px;position:relative;overflow:hidden;background:radial-gradient(ellipse at 79% 50%,#503022 0,#211813 24%,#10100f 55%)}.hero-copy{position:relative;z-index:1}.eyebrow,.hero-foot,.media-note,.site-footer>span,.site-footer>a:last-of-type{font:10px 'DM Mono',monospace;letter-spacing:.12em;color:#a7a198}.eyebrow{display:flex;align-items:center;gap:9px}.live-dot{width:7px;height:7px;border-radius:50%;background:#ed5632;box-shadow:0 0 12px #ed5632}.hero h1{font-size:clamp(58px,9vw,124px);line-height:.86;letter-spacing:-.085em;margin:36px 0 24px}.hero-intro{max-width:360px;color:#b7b3ad;line-height:1.6;margin-bottom:30px}.button{display:inline-flex;align-items:center;padding:16px 20px;font-size:13px;font-weight:600}.button-light{background:#f4f0e8;color:#10100f}.text-link{display:block;width:max-content;margin-top:21px;font-size:12px;border-bottom:1px solid #777;padding-bottom:5px}.text-link span{color:#ed5632}.hero-mark{position:absolute;width:42vw;height:42vw;max-width:540px;max-height:540px;right:8vw;top:80px;border:1px solid #f4f0e81c;border-radius:50%;display:grid;place-items:center;transform:rotate(-12deg);color:#ed5632}.hero-mark:before,.hero-mark:after{content:'';position:absolute;border:1px solid #f4f0e818;border-radius:50%;inset:10%}.hero-mark:after{inset:22%}.hero-mark>span{font-size:clamp(130px,28vw,360px);font-weight:700;letter-spacing:-.13em;color:#ed5632aa}.hero-mark i{position:absolute;right:14%;top:18%;font-size:36px;font-style:normal}.hero-foot{position:absolute;bottom:24px;left:6vw;right:6vw;display:flex;justify-content:space-between}.section-wrap{padding:100px 10vw}.shows{background:#ed5632;color:#10100f}.section-heading h2,.booking h2{font-size:clamp(48px,7vw,86px);line-height:.9;letter-spacing:-.08em;margin:18px 0 44px}.shows .eyebrow{color:#3c1c14}.shows .section-heading h2 span{color:#f4f0e8}.event-list{list-style:none;padding:0;margin:0;border-top:1px solid #35170f66}.event-row{display:grid;grid-template-columns:150px 1fr 100px 100px;gap:20px;align-items:center;padding:22px 0;border-bottom:1px solid #35170f66;font-family:'DM Mono',monospace;font-size:12px}.event-row time{font-size:12px}.event-row strong,.event-row div span{display:block}.event-row strong{font:600 18px 'Space Grotesk',sans-serif}.event-row div span{margin-top:4px;color:#54271d}.event-link{text-align:right}.event-link span{font-size:17px}.muted{opacity:.65}.about{display:grid;grid-template-columns:1.2fr .8fr;gap:9vw;align-items:center}.about .section-heading h2 span{color:#ed5632}.about-copy{max-width:380px;color:#b7b3ad;line-height:1.7}.about-copy p:first-child{font-size:20px;color:#f4f0e8}.about-copy .text-link{color:#f4f0e8}.media{padding-top:45px}.media-heading{display:flex;justify-content:space-between;align-items:end}.media-heading h2{margin-bottom:34px}.media-note{padding-bottom:42px}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.photo{margin:0;aspect-ratio:1.05;background:#1b1a18;overflow:hidden}.photo img{width:100%;height:100%;object-fit:cover;filter:saturate(.75)}.media-placeholder{grid-column:1/-1;min-height:280px;border:1px dashed #5a544c;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#9d978d}.media-placeholder>span{font-size:38px;color:#ed5632}.media-placeholder p{font:11px 'DM Mono',monospace;letter-spacing:.12em;color:#f4f0e8;margin:12px}.media-placeholder small,.reels-list p{font-size:12px}code{color:#ed967f;font-size:.9em}.reels-row{padding:64px 0 20px;display:grid;grid-template-columns:1fr 1fr;gap:8vw;border-bottom:1px solid #ffffff30}.reels-row h3{font-size:48px;line-height:.9;letter-spacing:-.08em;margin:14px 0}.reels-list{align-self:center}.reels-list>a{display:flex;justify-content:space-between;padding:16px 0;border-bottom:1px solid #ffffff30;font-size:14px}.reels-list>a span{color:#ed5632}.reels-list p{color:#a7a198;line-height:1.6}.reels-list .instagram-link{color:#ed5632}.booking{background:#ed5632;color:#10100f;text-align:center;padding:95px 20px}.booking .eyebrow{justify-content:center;color:#53251a}.booking h2{font-size:clamp(56px,9vw,112px);margin:23px 0 34px}.booking h2 span{color:#f4f0e8}.button-dark{background:#10100f;color:#f4f0e8}.button-dark span{color:#ed5632}.site-footer{min-height:112px;padding:25px 6vw;display:flex;align-items:center;justify-content:space-between;gap:20px}.site-footer>a:last-of-type{color:#f4f0e8}
  @media(max-width:700px){.site-header{height:72px;padding:0 6vw}.site-header nav{gap:14px;font-size:11px}.nav-book{padding:10px}.site-header nav>a:nth-child(2){display:none}.hero{min-height:660px;padding:95px 7vw 64px;background:radial-gradient(ellipse at 80% 55%,#503022 0,#211813 25%,#10100f 60%)}.hero-mark{width:78vw;height:78vw;right:-8vw;top:235px;opacity:.76}.hero-mark i{font-size:25px}.hero h1{font-size:clamp(58px,15vw,96px)}.hero-intro{max-width:300px}.hero-foot{left:7vw;right:7vw;font-size:8px}.section-wrap{padding:75px 7vw}.event-row{grid-template-columns:90px 1fr auto;gap:12px}.event-time{display:none}.event-row strong{font-size:16px}.event-row time,.event-row div span,.event-link{font-size:10px}.about{grid-template-columns:1fr;gap:0}.about-copy{margin-top:-15px}.media{padding-top:25px}.media-heading{align-items:flex-start}.media-heading h2{font-size:56px}.media-note{font-size:8px;padding-top:12px;text-align:right}.gallery{grid-template-columns:1fr 1fr;gap:8px}.media-placeholder{min-height:230px}.reels-row{grid-template-columns:1fr;gap:20px;padding-top:45px}.reels-row h3{font-size:42px}.booking{padding:80px 15px}.site-footer{padding:25px 7vw;flex-wrap:wrap}.site-footer>span:first-of-type{display:none}.site-footer>span:last-child{margin-left:auto}}
  @media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
</style>
